# Skopiuj ten plik jako .env i dostosuj wartości do swojego środowiska. (DamianTchorzewski_72206)

# Port, na którym nasłuchuje API. (DamianTchorzewski_72206)
PORT=3000
NODE_ENV=development

# Adres frontendu dopuszczony przez CORS (Vite domyślnie działa na porcie 5173). (DamianTchorzewski_72206)
FRONTEND_URL=http://localhost:5173

# Połączenie z bazą uruchamianą przez docker-compose.yml w katalogu głównym. (DamianTchorzewski_72206)
DATABASE_URL="postgresql://hotel_user:hotel_password@localhost:5432/hotel_c_db?schema=public"
