# Skopiuj ten plik jako .env i dostosuj wartości do swojego środowiska. (DamianTchorzewski_72206)

# Port, na którym nasłuchuje API. (DamianTchorzewski_72206)
PORT=3000
NODE_ENV=development

# Adres frontendu dopuszczony przez CORS (Vite domyślnie działa na porcie 5173). (DamianTchorzewski_72206)
FRONTEND_URL=http://localhost:5173

# Połączenie z bazą uruchamianą przez docker-compose.yml w katalogu głównym. (DamianTchorzewski_72206)
DATABASE_URL="postgresql://hotel_user:hotel_password@localhost:5432/hotel_c_db"

# Klucze zespołów zewnętrznych dla endpointów /integrations: nazwa:klucz, rozdzielone przecinkami. (DamianTchorzewski_72206)
# Każdy klucz ma od 16 do 128 znaków. Poniższe wartości służą tylko do pracy lokalnej, a produkcyjne wygeneruj osobno:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))" (DamianTchorzewski_72206)
INTEGRATION_API_KEYS=massage:dev-massage-key-0001,fitness:dev-fitness-key-0002
